# Copy to .env and fill in. Game Roulette will refuse to start if any of these are missing.

# Random long string used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Discord OAuth app credentials (https://discord.com/developers/applications).
# Create an app, add an OAuth2 redirect matching DISCORD_REDIRECT_URI below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Your own Discord user ID. The first person to log in with this ID becomes
# the group leader automatically (no invite link needed). Everyone else must
# redeem a leader-generated invite link to create an account.
INITIAL_LEADER_DISCORD_ID=

# Optional: enables Steam library import / search.
STEAM_API_KEY=

# Production database (Turso/libSQL). Leave both unset for local dev — the
# app then falls back to a local SQLite file at DB_PATH (below) via the same
# libSQL driver. Required when deploying to Vercel, since its filesystem is
# ephemeral and can't hold a local SQLite file between requests.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional overrides.
# PORT=3000
# DB_PATH=./roulette.db
